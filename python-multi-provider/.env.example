# Copy this file to .env and fill in your values.
# Never commit your real .env file.

# Default provider shown at the startup prompt: gemini (default) or zai.
LLM_PROVIDER=gemini

# Gemini: API key from Google AI Studio. Needed when LLM_PROVIDER=gemini.
GEMINI_API_KEY=your-key-here

# Optional: Gemini model to use. Defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# Z.ai (GLM): API key from z.ai. Needed when LLM_PROVIDER=zai.
ZAI_API_KEY=your-key-here

# Optional: Z.ai model to use. Must support function calling. Defaults to glm-5.3.
ZAI_MODEL=glm-5.3
